{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist/src",
    "noEmitOnError": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/main.ts", "src/bootstrap.ts", "src/render.ts", "src/engine.ts", "src/gfx/**/*.ts", "src/horror/**/*.ts"],
  "exclude": ["src/three/**/*"]
}
